<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MultiCodexStateGui.ViewModels" x:Class="MultiCodexStateGui.Views.MainWindow"
        x:DataType="vm:MainViewModel" Title="MultiCodexState" Icon="/Assets/app-icon.png"
        Width="1000" Height="800" MinWidth="740" MinHeight="500" WindowStartupLocation="CenterScreen"
        ExtendClientAreaTitleBarHeightHint="52">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="16,10" PointerPressed="OnHeaderPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border x:Name="MacTrafficLightSpacer" Width="0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="9">
                    <Image Source="/Assets/app-icon.png" Width="25" Height="25" VerticalAlignment="Center" />
                    <TextBlock Text="MultiCodexState" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6" Orientation="Horizontal">
                    <Button Content="Sign in" Classes="primary" Command="{Binding LoginCommand}" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
                    <Button Content="More" AutomationProperties.Name="More actions">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Sign out" Command="{Binding LogoutCommand}" />
                                <MenuItem Header="Check for updates" Command="{Binding CheckUpdateCommand}" />
                                <MenuItem Header="Install update" Command="{Binding UpdateCommand}" IsEnabled="{Binding !IsBusy}" />
                                <MenuItem Header="Accent color">
                                    <MenuItem Header="Blue" Command="{Binding SelectThemeCommand}" CommandParameter="cyber" />
                                    <MenuItem Header="Teal" Command="{Binding SelectThemeCommand}" CommandParameter="aurora" />
                                    <MenuItem Header="Rose" Command="{Binding SelectThemeCommand}" CommandParameter="synth" />
                                    <MenuItem Header="Sage" Command="{Binding SelectThemeCommand}" CommandParameter="matrix" />
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Panel Grid.Row="1">
            <ScrollViewer IsVisible="{Binding !IsEmpty}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,22" MaxWidth="1200" Spacing="18">
                    <Grid ColumnDefinitions="1.35*,0.75*,2.2*,0.8*" ColumnSpacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Current account" Classes="meta" />
                            <TextBlock Classes="heading" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"
                                       Text="{Binding ActiveAccount.Name, FallbackValue='No active archive', TargetNullValue='No active archive'}"
                                       ToolTip.Tip="{Binding ActiveAccount.Email}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Accounts" Classes="meta" />
                            <TextBlock Classes="heading" Text="{Binding TotalCount}" />
                            <TextBlock Classes="meta"><Run Text="{Binding HealthyCount}"/><Run Text=" valid" /></TextBlock>
                        </StackPanel>
                        <Panel Grid.Column="2">
                            <ItemsControl ItemsSource="{Binding ActiveAccount.Windows}" IsVisible="{Binding ActiveAccount.HasWindows, FallbackValue=False}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:WindowViewModel">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="meta"><Run Text="{Binding Label}" /><Run Text=" usage" /></TextBlock>
                                            <TextBlock Classes="heading" Text="{Binding PercentText}" />
                                            <TextBlock Classes="meta" Text="{Binding RemainingText}" IsVisible="{Binding HasRemaining}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel IsVisible="{Binding !ActiveAccount.HasWindows, FallbackValue=True}" Spacing="4">
                                <TextBlock Text="Current usage" Classes="meta" />
                                <TextBlock Text="—" Classes="heading" />
                                <TextBlock Classes="meta" Text="{Binding QuotaPlaceholder}" />
                            </StackPanel>
                        </Panel>
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="Reset credits" Classes="meta" />
                            <TextBlock Classes="heading" Text="{Binding TotalResetCreditsText}" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource LineBrush}" />
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Text="Account archive" Classes="heading" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="215" MinHeight="30" PlaceholderText="Search accounts"
                                 AutomationProperties.Name="Search accounts" Text="{Binding SearchQuery}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,-8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="All" Classes="quiet" Classes.selected="{Binding IsFilterAll}" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                            <Button Content="Active" Classes="quiet" Classes.selected="{Binding IsFilterActive}" Command="{Binding SetFilterCommand}" CommandParameter="active" />
                            <Button Content="Valid" Classes="quiet" Classes.selected="{Binding IsFilterHealthy}" Command="{Binding SetFilterCommand}" CommandParameter="healthy" />
                            <Button Classes="quiet" Classes.selected="{Binding IsFilterAlerts}" Command="{Binding SetFilterCommand}" CommandParameter="alerts">
                                <TextBlock><Run Text="Alerts (" /><Run Text="{Binding AlertCount}" /><Run Text=")" /></TextBlock>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Sort" Classes="meta" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Content="Default" Classes="quiet" Classes.selected="{Binding IsSortDefault}" Command="{Binding SetSortCommand}" CommandParameter="default" />
                            <Button Content="Quota" Classes="quiet" Classes.selected="{Binding IsSortRemaining}" Command="{Binding SetSortCommand}" CommandParameter="remaining" />
                            <Button Content="Name" Classes="quiet" Classes.selected="{Binding IsSortName}" Command="{Binding SetSortCommand}" CommandParameter="name" />
                        </StackPanel>
                    </Grid>
                    <StackPanel IsVisible="{Binding IsFilterEmpty}" HorizontalAlignment="Center" Spacing="10" Margin="0,26">
                        <TextBlock Text="No matching accounts" />
                        <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding FilteredAccounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:AccountViewModel">
                                <Border Classes="panel" Margin="0,0,0,10">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="3">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Right" Text="Active" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                               IsVisible="{Binding IsActive}" Margin="10,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding DisplayName}" Classes="meta" IsVisible="{Binding HasDisplayName}" />
                                                <DockPanel HorizontalAlignment="Left" IsVisible="{Binding HasEmail}">
                                                    <Button DockPanel.Dock="Right" Content="Copy" Classes="quiet" FontSize="11" MinHeight="20" Padding="6,0"
                                                            ToolTip.Tip="Copy email address" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyEmailCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Text="{Binding Email}" Classes="meta" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding PlanDisplay}" Classes="meta" IsVisible="{Binding HasPlan}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusDisplay}" Classes="meta" Classes.warning="{Binding IsTokenWarning}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ExpiryText}" Classes="meta" IsVisible="{Binding HasExpiry}" VerticalAlignment="Center" />
                                                <Button Content="Switch" IsVisible="{Binding !IsActive}" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).SwitchCommand}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Loading quota…" Classes="meta" IsVisible="{Binding IsLoading}" />
                                        <ItemsControl ItemsSource="{Binding Windows}" IsVisible="{Binding HasWindows}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="18" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:WindowViewModel">
                                                    <StackPanel Spacing="5" Margin="0,5,0,0">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock><Run Text="{Binding Label}" /><Run Text=" usage" /></TextBlock>
                                                            <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontWeight="SemiBold" />
                                                        </Grid>
                                                        <ProgressBar Value="{Binding PercentValue}" Maximum="100" AutomationProperties.Name="{Binding Label}"
                                                                     Classes.warning="{Binding IsElevated}" Classes.critical="{Binding IsCritical}" />
                                                        <TextBlock Classes="meta" Text="{Binding RemainingText}" IsVisible="{Binding HasRemaining}" />
                                                        <TextBlock Classes="meta" Classes.warning="{Binding IsResetSoon}" Classes.error="{Binding IsResetDue}"
                                                                   Text="{Binding ResetText}" IsVisible="{Binding HasReset}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="meta" IsVisible="{Binding HasCredits}" Text="{Binding CreditsText}" />
                                        <TextBlock Classes="meta" IsVisible="{Binding HasApproxMessages}" Text="{Binding ApproxMessagesText}" />
                                        <ItemsControl ItemsSource="{Binding ModelUsageItems}" IsVisible="{Binding HasModelUsage}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate DataType="vm:ModelUsageChip">
                                                <TextBlock Classes="meta" Margin="0,0,16,0"><Run Text="{Binding Model}" /><Run Text="  " /><Run Text="{Binding PercentText}" /></TextBlock>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="meta" Text="{Binding UsageNote}" IsVisible="{Binding HasUsageNote}" TextWrapping="Wrap" />
                                        <TextBlock Classes="error" Text="Rate limit reached" IsVisible="{Binding HasLimitReached}" />
                                        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="No archived accounts" Classes="heading" HorizontalAlignment="Center" />
                <TextBlock Classes="meta" Text="Sign in with Codex to add an account to this device." />
                <Button Classes="primary" Content="Sign in with Codex" Command="{Binding LoginCommand}" HorizontalAlignment="Center" />
            </StackPanel>
            <Border Classes="panel" IsVisible="{Binding IsHudOpen}" Width="480" Margin="18" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <StackPanel Spacing="8">
                    <DockPanel><Button DockPanel.Dock="Right" Content="Close" Classes="quiet" Command="{Binding ToggleHudCommand}" /><TextBlock Text="Local paths" FontSize="17" FontWeight="SemiBold" /></DockPanel>
                    <TextBlock Text="Loading paths…" Classes="meta" IsVisible="{Binding IsWhereLoading}" />
                    <TextBlock Text="Live credentials" Classes="meta" />
                    <DockPanel><Button DockPanel.Dock="Right" Content="Copy" Classes="quiet" Command="{Binding CopyTextCommand}" CommandParameter="{Binding AuthJsonPath}" />
                        <TextBlock Text="{Binding AuthJsonPath}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                    <TextBlock Text="Archive directory" Classes="meta" />
                    <DockPanel><Button DockPanel.Dock="Right" Content="Copy" Classes="quiet" Command="{Binding CopyTextCommand}" CommandParameter="{Binding AccountsDirPath}" />
                        <TextBlock Text="{Binding AccountsDirPath}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                    <TextBlock Text="Codex executable" Classes="meta" />
                    <DockPanel><Button DockPanel.Dock="Right" Content="Copy" Classes="quiet" Command="{Binding CopyTextCommand}" CommandParameter="{Binding CodexBinaryPath}" />
                        <TextBlock Text="{Binding CodexBinaryPath}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                </StackPanel>
            </Border>
        </Panel>
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,5">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Classes="meta" Classes.error="{Binding HasStatusError}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !HasToast}" ToolTip.Tip="{Binding StatusText}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastMessage}" Classes="meta" IsVisible="{Binding HasToast}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="meta" Text="{Binding LastRefreshedText}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="quiet" Content="Paths" Command="{Binding ToggleHudCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
